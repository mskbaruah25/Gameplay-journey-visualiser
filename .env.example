# Local development. Use COMPOSE_PROFILES= and your Neon URL for a managed database.
COMPOSE_PROFILES=local
DATABASE_URL=postgresql://lila:lila_local_only@postgres:5432/lila
# Neon: pooled URL above for web reads, direct URL below for migration and ETL.
# Leave this empty when using the local PostgreSQL container.
DATABASE_URL_UNPOOLED=
POSTGRES_PASSWORD=lila_local_only
POSTGRES_PORT=55432
MINIO_ROOT_USER=lila_local
MINIO_ROOT_PASSWORD=lila_storage_local_only
S3_BUCKET=lila-gameplay
DATASET_YEAR=2026
SPARK_DRIVER_MEMORY=512m
WEB_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
